# Copy to .env.local and set your local credentials. Never commit .env.local.
# Gmail SMTP uses the same mailbox for From and test receipt To.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay Dashboard Test Mode keys.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
